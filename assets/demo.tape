# pkgtruth — demo
# Render:  vhs demo.tape

Output demo.gif
Output demo.mp4

Set Shell bash
Set FontSize 19
Set Width 1280
Set Height 500
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set BorderRadius 9

Hide
Type "cd /private/tmp/claude-501/-Users-hxckya/d9a6aa9d-ad89-4b7d-b339-350c27e2d39a/scratchpad/realuser"
Enter
Type "export NODE_EXTRA_CA_CERTS=/Users/hxckya/ca-bundle.pem"
Enter
Type "export PATH=/private/tmp/claude-501/-Users-hxckya/d9a6aa9d-ad89-4b7d-b339-350c27e2d39a/scratchpad/demobin:$PATH"
Enter
Type "export PS1='$ '"
Enter
Type "clear"
Enter
Sleep 500ms
Show

Sleep 800ms
Type "# Your AI just told you to install these three."
Enter
Sleep 1500ms
Type "# Two will hurt you. Spot them."
Enter
Sleep 2400ms

Type "pkgtruth check lodash unused-imports imageprocessor-lite"
Sleep 400ms
Enter
Sleep 7000ms
